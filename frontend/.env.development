VITE_API_BASE_URL=http://localhost:5000/api/v1

# Auth Configuration
# Set to 'false' to hide mobile phone OTP login (email OTP will be default)
# Set to 'true' to show mobile phone OTP login option
VITE_ENABLE_PHONE_LOGIN=false

# Firebase Configuration (for Google Sign-In & FCM Push Notifications)
# Get these from your Firebase Console -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
