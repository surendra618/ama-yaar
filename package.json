{
  "name": "ama-yaar",
  "private": true,
  "version": "0.1.0",
  "description": "AMA-YAAR e-commerce marketplace monorepo",
  "workspaces": [
    "backend",
    "frontend",
    "admin"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:admin": "npm run dev --workspace admin",
    "dev": "concurrently -n BACKEND,FRONTEND,ADMIN -c blue,green,magenta \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:admin\"",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
